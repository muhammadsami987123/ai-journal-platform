{
  "name": "@journal/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "NestJS API — auth, journal domain, AI and voice integrations.",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",

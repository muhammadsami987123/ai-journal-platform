    "@nestjs/platform-express": "12.5.0",
    "@nestjs/swagger": "12.1.2",
    "@thallesp/nestjs-better-auth": "2.8.0",
    "better-auth": "1.7.25",
    "cookie-parser": "1.4.7",
    "dotenv": "18.0.10",
    "drizzle-orm": "0.45.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@journal/config": "workspace:*",
    "@nestjs/cli": "12.0.13",
    "@nestjs/testing": "12.5.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/supertest": "6.0.3",
    "rimraf": "6.1.2",
    "supertest": "7.3.2",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }

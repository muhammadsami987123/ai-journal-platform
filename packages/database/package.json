{
  "name": "@journal/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Drizzle schema, migrations, seeds and connection factory for the AI Journal platform.",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    }
  },
  "files": ["dist", "migrations", "sql"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "lint": "eslint .",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate.ts",
    "check": "tsx src/check.ts",
    "seed": "tsx seeds/index.ts",
    "db:health": "tsx src/health.ts",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@journal/shared": "workspace:*",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@journal/config": "workspace:*",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "dotenv": "18.0.10",
    "drizzle-kit": "0.31.11",
    "rimraf": "6.1.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}

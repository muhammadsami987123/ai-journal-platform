# Normalize line endings for every text file, regardless of platform.
* text=auto eol=lf

# Explicit text types (keeps diffs readable even if a tool writes CRLF)
*.md        text eol=lf
*.mdx       text eol=lf
*.txt       text eol=lf
*.json      text eol=lf
*.jsonc     text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.mjs       text eol=lf
*.cjs       text eol=lf
*.css       text eol=lf
*.scss      text eol=lf
*.html      text eol=lf
*.sql       text eol=lf
*.sh        text eol=lf
*.toml      text eol=lf
.editorconfig text eol=lf
.gitignore    text eol=lf
.gitattributes text eol=lf
.env.example  text eol=lf
LICENSE       text eol=lf

# Windows-only scripts must keep CRLF
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# Binary assets — never diff, never normalize
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.avif      binary
*.ico       binary
*.svg       text eol=lf
*.woff      binary
*.woff2     binary
*.ttf       binary
*.otf       binary
*.pdf       binary
*.zip       binary
*.mp3       binary
*.wav       binary
*.webm      binary

# Lockfiles and generated files: exclude from language stats and review noise
pnpm-lock.yaml linguist-generated=true
package-lock.json linguist-generated=true
yarn.lock linguist-generated=true

# Keep documentation language stats honest — the repo is documentation-heavy right now
docs/**/*.md linguist-documentation=true
reports/**/*.md linguist-documentation=true

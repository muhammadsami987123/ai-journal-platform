# =============================================================================
# AI Journal — Environment Variable Contract
# =============================================================================
# Copy to `.env` (never commit the real file). Values below are placeholders.
# Rule: every key here must exist in the deployment environment, and NO secret
# may ever be exposed to the client bundle. AI / DB / auth secrets are
# server-only.
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime & origins
# -----------------------------------------------------------------------------
NODE_ENV=development

# Public origin — the ONLY origin the browser ever sees (cookies, CSRF, auth URL).
APP_URL=http://localhost:3000

# Server-to-server address of the NestJS API. Never exposed to the browser.
API_INTERNAL_URL=http://localhost:3001

# Browser-visible API base. Relative on purpose: requests are proxied through
# the web origin so the session cookie stays first-party.
NEXT_PUBLIC_API_BASE_URL=/api

# Ports (local development)
WEB_PORT=3000
API_PORT=3001

# -----------------------------------------------------------------------------
# Database — Neon PostgreSQL
# -----------------------------------------------------------------------------
# Pooled connection (used by the application at runtime)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
# Direct connection (used for migrations and schema diffs only)
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require

# -----------------------------------------------------------------------------
# Authentication — Better Auth (mounted inside NestJS at /api/auth/*)
# -----------------------------------------------------------------------------
BETTER_AUTH_SECRET=
# Must equal the public origin (APP_URL), never the internal API address.
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated trusted origins for CSRF checks
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# AI provider (configurable — no vendor lock-in)
# -----------------------------------------------------------------------------
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.provider.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_MAX_INPUT_TOKENS=16000
LLM_TIMEOUT_MS=60000
PROMPT_VERSION=v1

# -----------------------------------------------------------------------------
# Speech-to-text (optional server fallback; browser STT is the primary path)
# -----------------------------------------------------------------------------
STT_PROVIDER=
STT_API_KEY=
STT_DEFAULT_LANGUAGE=en-US

# -----------------------------------------------------------------------------
# File storage (attachments — PLUS phase only)
# -----------------------------------------------------------------------------
BLOB_STORAGE_PROVIDER=
BLOB_STORAGE_BUCKET=
BLOB_STORAGE_REGION=
BLOB_STORAGE_ACCESS_KEY=
BLOB_STORAGE_SECRET_KEY=
BLOB_MAX_UPLOAD_MB=15

# -----------------------------------------------------------------------------
# Reminders (only if the server-cron delivery path is chosen)
# -----------------------------------------------------------------------------
CRON_SECRET=
REMINDER_CHANNEL=browser

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
LOG_LEVEL=info
SENTRY_DSN=
